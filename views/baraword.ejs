  <script>
       var count = 1;
      $("#myinput").on("search",function(){
          var search_input = $("#myinput").val();
          //alert(search_input);
          var data ={};

                $.ajax({
                    type: 'POST',
                    data: JSON.stringify(data),
                    contentType: "application/json",
                    dataType:'json',
                    url: '/mahsol_items?param='+search_input,                      
                    success: function(data) {
                
                        var js_arr = JSON.stringify(data);
                        var str_array = js_arr.split(',');

                        var newStr = js_arr.substring(1, js_arr.length-1);
                        var parsedJSON = JSON.parse(newStr);
                        var st_id = parsedJSON.id;
                        
                    //alert(st_id);
                   //$("#stak_to_market_id").val(st_id);
                    var name = parsedJSON.item_name;
                    // alert(name)
                    var quantity= 1;
                    
                    var buy_type = parsedJSON.item_type;
                    var price = parsedJSON.price;
                    //alert(price)
                    var total = price * quantity ;
                   
                    var html_code = "<tr id='row_id_"+count+"'>";

                    html_code+=
                    '<td>'+count+'</td>';
                    html_code+=
                    '<td><input type="text" name="item" readonly value="'+name+'" class="form-control item" id="'+count+'"></td>';
                    /* html_code+=
                    '<input type="hidden" name="stak_r_m_id" value="'+st_id+'" id="'+count+'" class="form-control item">'; */
                    html_code+=
                    '<td><input type="text" name="type" readonly value="'+buy_type+'" class="form-control item" id="'+count+'"></td>';
                    html_code+=
                    '<td><input type="text" name="quantity" value="'+quantity+'" class="form-control quantity" id="quantity_'+count+'"></td>';
                     html_code+=
                    '<td><input type="text" name="price" value="'+price+'" class="form-control price" id="price_'+count+'"></td>'; 
                    html_code+=
                    '<td><input type="text" name="total" value="'+total+'" readonly class="form-control total" id="total_'+count+'"></td>';
                    html_code+=
                    '<td class="print"><span class="delete-img print"  id="'+count+'" ><img width="25px" style="cursor: pointer;" src="assets/img/mawadkham/trash.svg" alt=""></span></td>';
                    html_code += "</tr>";
                    
                    $("#tbody").append(html_code);
                    cal_final_total(count);
                    count++;

                    $("#myinput").val("");
                        
                    },
                    error: function(error) {
                        console.log("some error in fetching the notifications");
                    }
                });
          //////

          function cal_final_total(count) {
                var total_amount = 0;
                var actual_amount = 0;
                var expenses = 0;
                var expenses = $("#expenses").val();
                for (var x = 1; x <= count; x++) {
                    var order_item_quantity = $("#quantity_" + x).val();
                    if (order_item_quantity > 0) {
                        var order_item_price = $("#price_" + x).val();
                         actual_amount = (parseFloat(order_item_quantity) * parseFloat(order_item_price));
                        $("#total_" + x).val(actual_amount);
                        var total_amount = parseFloat(total_amount) + parseFloat(actual_amount) ;
                        
                        var total__ = $("#quantity-show").val();
                        var reciept_show = $("#reciept-show").val();
                        $("#total-show").val(total__-reciept_show);
                    }
                    
                    
                }
                var final_amount = total_amount + parseFloat(expenses);
                $("#quantity-show").val(final_amount);
            }

            $(document).on('keyup', '.quantity', function() {
                cal_final_total(count);
            });

            $(document).on('keyup', '.price', function() {
                cal_final_total(count);
            });

            // $(document).on('keyup', '#reciept-show', function() {
            //     cal_final_total(count);
            // });

            // $(document).on('keyup', '#total-show', function() {
            //     cal_final_total(count);
            // });

            // $(document).on('keyup', '#quantity-show', function() {
            //     cal_final_total(count);
            // });

           
      });
  </script>
