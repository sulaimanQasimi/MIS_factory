   <script>
     
     $("#update_com_info").submit(function () {
      var formData = new FormData(this);
      $.ajax({
          url: '/update_com_info_02',
          type: 'POST',
          data: formData,
          async: false,
          cache: false,
          contentType: false,
          processData: false,
          success: function (data) {
              window.location.href= "company-reg.ejs";
          },
          error: function(data){
              alert(data);
          }
      });
      return false;
  });
   </script>

   <script>
     function delete1(id)
              {
                //alert(id);
                var result = confirm('are you sure ?');
                if(result == true)
                {
                  var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/delete_company_info?param='+id,                      
                        success: function(data) {
                           window.location.href= "emp_SP_reg.ejs";
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
                }
              }

              function update_company(id)
              {
                var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/update_comapny_info?param='+id,                      
                        success: function(data) {
                          var obj_to_staring = JSON.stringify(data);//always server data is coming in object type we have to converted in string

                           var string_to_object = JSON.parse(obj_to_staring);//for accessing the value of key we have to convert to object
                           var shamsi_date = string_to_object.data;//our first part of data converted to object so we can access the value
                           var name1 = string_to_object.data1;//our second part of data still in string type so we again convt to obj

                           var pars2 = JSON.parse(name1);//here we have parse(convrt to obj) it again,because second parts was nested string

                          var expense_id= pars2.id;
                          var company_name=  pars2.company_name;
                          var description =  pars2.description;
                          var location =  pars2.location;
                          var contact=  pars2.contact;
                          var email = pars2.email;
                          var website = pars2.website;
                          var logo = pars2.logo;
                          var currency = pars2.currency;
                          var backup_url = pars2.backup_url;
                          // var starting_activity = pars2.starting_activity;
                          

                          $("#expense_id").val(expense_id);
                          $("#company_name").val(company_name);
                          $("#description").val(description);
                          $("#location").val(location);
                         
                          $("#contact").val(contact);
                          $("#email").val(email);
                          $("#website").val(website);
                          $('#myImage').attr('src',logo);
                          $('#currency').val(currency);
                          $('#backup_add').val(backup_url);
                          
                          $("#data_man").val(shamsi_date);
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
              }
   </script>
