<section class="all-web">
    <div class="container-fluid">
        <div class="row">
            <div class="panel col-sm-12 col-md-3">
                <div class="color-box">
                  <a href="dis-reg.ejs"><img width="70px" src="assets/img/disposal.svg" alt="disposal"></a>
                </div>
                <div class="content">
                    <h2 class="numbers"><%= expenses %> 
                    </h2>  
                    <h6>مجموعه مصارف</h6>
                </div>
            </div>

            <div class="panel col-sm-12 col-md-3">
                <div class="color-box">
                  <a href="raw_material_store.ejs"><img width="70px" src="assets/img/disposal.svg" alt="disposal"></a>
                </div>
                <div class="content">
                    <h2 class="numbers"><%= purchase %> 
                    </h2>  
                    <h6>مجموعه خرید مواد خام</h6>
                </div>
            </div>

            <div class="panel col-sm-12 col-md-3">
              <div class="color-box balance">
                <a href="froshat_view.ejs">  <img width="70px" src="assets/img/total_sales.svg" alt="disposal"></a>
              </div>
              <div class="content" >
                  <h2 class="numbers"><%= sell_amount %>
                  </h2>
                  <h6>مجموعه فروشات</h6> 
                 
              </div>
          </div>
          <div class="panel col-sm-12  col-md-3">
            <div class="color-box sales">
              <img width="70px" src="assets/img/create_order.svg" alt="disposal">
            </div>
            <div class="content">
                <h2 class="numbers"><%= (sell_amount -(expenses + purchase)).toFixed(3);  %>
                </h2>
                <h6>مفاد </h6>
                
            </div>
        </div>
        <div class="panel col-sm-12  col-md-3">
          <div class="color-box orders">
           <a href="oloan_reg.ejs"> <img width="70px" src="assets/img/money_pound.svg" alt="disposal"></a>
          </div>
          <div class="content">
              <h2 class="numbers"><%= outging_loan %></h2>
              <h6>  مجموعه قرضه های خروجی</h6>
            </div>
      </div>

      <div class="panel col-sm-12  col-md-3">
        <div class="color-box orders">
            <a href="iloan_reg.ejs"><img width="70px" src="assets/img/money_pound.svg" alt="disposal"></a>
        </div>
        <div class="content">
            <h2 class="numbers"><%= incoming_loan %></h2>
            <h6>  مجموعه قرضه های داخلی</h6>
          </div>
    </div>
        </div>
    </div>
</section>
