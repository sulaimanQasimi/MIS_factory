        <script>
          function delete1(id)
              {
                
                var result = confirm('are you sure ?');
                if(result == true)
                {
                  var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/delete_emp_reg?param='+id,                      
                        success: function(data) {
                           window.location.href= "emp-reg.ejs";
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
                }
              }

          function update_employees(id)
              {
               
                var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/update_emp_regs?param='+id,                      
                        success: function(data) {
                          var obj_to_staring = JSON.stringify(data);//always server data is coming in object type we have to converted in string

                           var string_to_object = JSON.parse(obj_to_staring);//for accessing the value of key we have to convert to object
                           var shamsi_date = string_to_object.data;//our first part of data converted to object so we can access the value
                           var name1 = string_to_object.data1;//our second part of data still in string type so we again convt to obj

                           var pars2 = JSON.parse(name1);//here we have parse(convrt to obj) it again,because second parts was nested string

                          var expense_id= pars2.id;
                          var name= pars2.name;
                          var last_name= pars2.last_name;
                          var contact= pars2.contact;
                          /* var email = pars2.email;
                          var tazkira = pars2.tazkira; */
                          var address = pars2.address;
                          var job_place = pars2.job_place;
                          var job_type = pars2.job_type;
                          var id_number = pars2.id_number;
                          var salary = pars2.salary;
                          var image = pars2.image;
                         
                          
                          $("#expense_id").val(expense_id);
                          $("#emp_name").val(name);
                          $("#last_name").val(last_name);
                          $("#contact").val(contact);
                          /* $("#email").val(email);
                          $("#tazkira").val(tazkira); */
                          $("#address").val(address);
                          $("#working_location").val(job_place);
                          $("#job_type").val(job_type);
                          $("#id_number").val(id_number);
                          $("#salary").val(salary);
                         // $("#image").val(image);
                          $('#myImage').attr('src',image);
                          $("#data_man").val(shamsi_date);
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
              }

              function from_to_date()
              {
                       $("#input_laoner").hide();
                   // var id = $("#edit_id").val();
                    var from_date =  $("#date_man").val();
                    var to_date =$("#date_man1").val();
                   
                      $.ajax({
                        url: '/from_date_to_cs_reg_01?from_date='+from_date+'&to_date='+to_date,
                            type: 'POST',
                            //data: formData,
                            async: false,
                            cache: false,
                            contentType: false,
                            processData: false,
                            success: function (data) {
                           //  $(".all_data").hide();
                             $(".all_data").html(data);
                              
                            },
                            error: function(data){
                                alert(data);
                            }
                        });
                        return false;
              }
        </script>
