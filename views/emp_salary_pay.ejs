<script>
    
  $(document).ready(()=>{
    $(function() {
    $('#date_man').datepicker({
         changeMonth: true,
         changeYear: true
     });
  });

var tax =  $('#tax');
var salary =  $('#salary');
var extra =  $('#extra');
var removal =  $('#removal');
var after_tax =  $('#after_tax');
var payable =  $('#payable');

function payable_calc(){


  // code for extra salary is not included in tax
  var taxed = (parseInt(salary.val())) - ((parseInt(salary.val()))/100)*parseInt(tax.val());
  after_tax.val(taxed);
  var final_pay = parseInt(after_tax.val()) -parseInt(removal.val()) +parseInt(extra.val());
  payable.val(final_pay); 


  // code for extra salary included in tax
  // var taxed = parseInt(salary.val()) - (parseInt(salary.val())/100)*parseInt(tax.val());
  // after_tax.val(taxed);
  // var final_pay = taxed + parseInt(extra.val()) -parseInt(removal.val())  ;
  // payable.val(final_pay); 

}

salary.keyup(()=>{
  payable_calc();
});

tax.keyup(()=>{
  payable_calc();
});

extra.keyup(()=>{
  payable_calc();
});

removal.keyup(()=>{  
  payable_calc();
  });
});

$(function(){
    var item_name = $("#item_name").val();
    showUser(item_name);
  });

function showUser(id){

var data ={};

$.ajax({
    type: 'POST',
    data: JSON.stringify(data),
    contentType: "application/json",
    dataType:'json',
    url: '/get_stuff_salary?param='+id,                      
    success: function(data) {
   
        var js_arr = JSON.stringify(data);
        var str_array = js_arr.split(',');
      
       
       var newStr = js_arr.substring(1, js_arr.length-1);
       var parsedJSON = JSON.parse(newStr);
       var name = parsedJSON.name;
       var last_name = parsedJSON.last_name;
       var salary = parsedJSON.salary;
      
       var taken = parsedJSON.totalcount;
       if(taken == null )
       {
         var taken = 0;
        $("#removal").val(taken);
       }
       var payable = salary - taken;
       //alert(payable);
       
       $("#emp_name").val(name);
       $("#emp_fname").val(last_name);
       $("#salary").val(salary);
       $("#removal").val(taken);
       $("#payable").val(payable);
      //  $("#currency").val(currency);
      //  $("#to_dollar").val(ex_rate);
        
    },
    error: function(error) {
        console.log("some error in fetching the notifications");
    }
});
}

const $form = $('#form1')
  
  $form.on('submit', submitHandler)
  
  function submitHandler (e) {
    e.preventDefault()
    $.ajax({
      url: '/employ_salary_pay',
      type:'POST',
      data: $form.serialize()
    }).done(response => {
      alert(response);
      document.getElementById("form1").reset();
      change_c();
    })
  }

</script>
