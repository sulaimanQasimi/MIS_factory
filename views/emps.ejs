    <div class="container">
      <div class="row">
      <section class="all-web" >

        <h3 class="mt-5 mb-5 " style="text-align: center;">ثبت معلومات  درباره کارمندان شرکت</h3>
        <hr>
        <br>
        <form action="" method="POST" class="needs-validation" enctype="multipart/form-data" id="uploadForm">
        <div class="row">
          <div class="col-xs-12 col-sm-12 col-md-10 col-lg-4">
            <div class="input-group">
              <label class="mt-2" for="emp_name" >نام کارمند:</label>
              <input type="text" id="emp_name" name="emp_name" required class="emp_name mb-3 col-12 form-control">
              
            </div>
            <div class="input-group">
              <label class="mt-2" for="emp_fname" >تخلص کارمند:</label>
              <input type="text" id="emp_fname" name="emp_fname"  class="emp_fname mb-3 col-12 form-control">
            </div>
            <div class="input-group">
              <label class="mt-2" for="emp_phone" >تیلیفون :</label>
              <input type="text" id="emp_phone" name="emp_phone"  class="emp_phone mb-3 col-12 form-control">
            </div>

            <!-- <div class="input-group">
              <label class="mt-2" for="emp_email" >ایمیل (اختیاری) :</label>
              <input type="email" id="emp_email" name="emp_email" required class="emp_email mb-3 col-12 form-control">
            </div> -->

          </div>

          <!-- second -->
          <div class="col-xs-12 col-sm-12 col-md-10 col-lg-4">

            <!-- <div class="input-group">
              <label class="mt-2" for="emp_tazkira" >نمبر تذکره :</label>
              <input type="text" id="emp_tazkira" name="emp_tazkira" required class="emp_tazkira mb-3 col-12 form-control">
            </div> -->

            <div class="input-group">
              <label class="mt-2" for="emp_add" > آدرس:</label>
              <textarea type="text" id="emp_add" name="emp_add" required class="emp_add mb-3 col-12 form-control"></textarea>
            </div>
            <div class="input-group">
              <label class="mt-2" for="emp_j_area" >ساحه کاری :</label>
              <input type="text" id="j_area" name="j_area" required class="j_area mb-3 col-12 form-control">
            </div>
            <div class="input-group">
              <label class="mt-2" for="emp_j_type" >نوعیت کاری :</label>
              <input type="text" id="emp_j_type" name="emp_j_type" required class="emp_j_type mb-3 col-12 form-control">
            </div>
          </div>
          <!-- third -->
          <div class="col-xs-12 col-sm-12 col-md-10 col-lg-4">
            <div class="input-group">
              <label class="mt-2" for="emp_salary" >معاش :</label>
              <input type="text" id="emp_salary" name="emp_salary" required class="emp_salary mb-3 col-12 form-control">
            </div>
            <div class="input-group">
              <label class="mt-2" for="emp_id_staff" >نمبر ثبت کارمند:</label>
              <input type="text" id="emp_id_staff" name="emp_id_staff" required class="emp_id_staff mb-3 col-12 form-control">
            </div>
            <div class="input-group">
              <label class="mt-2 " for="emp_img" > تصویر:</label>
              <!-- <input type="file"  id="emp_img" name="emp_img" class="emp_img mb-3 col-12 form-control"> -->
              <label class="btn mb-3 mt-2 st btn-default btn-sm form-control center-block btn-file">
                <i style="color:dodgerblue;" class="fa fa-upload fa-2x" aria-hidden="true"></i>
                <input type="file" style="display: none;" id="upload-input" name="upload">
              </label>
            </div>
            <div class="input-group">
              <label class="mt-2" for="date-man" >تاریخ :</label>
              <input type="text" id="date-man" required name="date_man" class="date-man mb-3 col-12 form-control">
            </div>
          </div>
          <div class="col-sm-12 height" style="height:40px;"></div>
          <div class="col-sm-3"><a style="color: #fff;" href="emp-reg.ejs" class="btn btn-sm btn-success">کارمندان ثبت شده</a></div>
          <div class="col-sm-6">
            <input type="submit" class="btn btn-primary rounded-pill" style="width:100%;" value="ذخیره">
          </div>
          
        </div>
      </form>
      
        
      </section>
      </div>
    </div>
     
 
