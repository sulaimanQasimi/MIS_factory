$("#uploadForm").submit(function () {
      var formData = new FormData(this);
      $.ajax({
          url: '/up_image',
          type: 'POST',
          data: formData,
          async: false,
          cache: false,
          contentType: false,
          processData: false,
          success: function (data) {
              // alert(data);
              document.getElementById("uploadForm").reset();
          },
          error: function(data){
              alert(data);
          }
      });
      return false;
  });
    

