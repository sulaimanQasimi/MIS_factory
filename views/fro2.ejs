<body>
<!-- start all web -->
<section class="all-web">
    <div class="container-fluid">
        <div class="row">
            <div class="fro-entry col-11 mx-auto">
                <h3 style="color: white; text-align: center; margin-top:40px ;">بل فروشات</h3>
                <div class="company-brand" style="width: 40%;">
                    <div class="logo">
                        <img width="100%" src="assets/img/co-nav.png" alt="logo">
                    </div>
                    <div class="title">
                        <% data_02.forEach(function(fro_details) {  %>
                        <h3 style="color: white;"> <%= fro_details.company_name %></h3>
                        <h6 style="color: lightgray;"><%= fro_details.description %></h6>
                        <% }); %>
                    </div>
                </div>
                        
                       <div style="color: white;" class="invoice-number">
                           نمبر بل: <%= data_04 +1 %>
                       </div>
                      
            </div>
      </div>
        </div>
</section>
 <!-- end section all web -->
 <!-- invoice start -->
 <div id="all-invoice" class="all-invoice col-11 mx-auto">
    <div class="container-fluid">
        <!-- <form class="col-sm-12 mt-5" action="" enctype="multipart/form-data" id="data_for_invoice">  -->
        <div class="row">
            <div class="company-brand">
                <div class="">
                    <!-- <img width="100%" src="assets/img/co-nav.png" alt="logo"> -->
                </div>
                <div class="title">
                    <!-- <h3>عصر پویا</h3>
                    <h6>پیشتاز در عرصه تولیدات صنعتی</h6> -->
                </div>
            </div>
                   <div class="invoice-number">
                       <!-- نمبر بیل: 12288 -->
                   </div>
                   <div class="blank-spce"></div>
                   <div class="detail">
                    <% data_02.forEach(function(fro_details) {  %>
                       <div class="owner">
                           <div class="input-group">
                            <label class="mt-2" for="owner_name">نام فروشنده :</label>
                            <span><%= fro_details.company_name %></span>
                           </div>
                            <div class="input-group">
                                <label class="mt-2" for="owner_detail1">تیلیفون  :</label>
                           <span><%= fro_details.contact %></span>
                            </div>
                          <div class="input-group">
                            <label class="mt-2" for="owner_detail2">ایمیل  :</label>
                            <span><%= fro_details.email %></span>
                          </div>
                        </div>
                        <% }); %>
                       <div class="customer">
                        <div class="input-group">
                            <label class="mt-2" for="customer-name">نام خریدار :</label>
                            <input type="text" form="data_for_invoice" id="customer-name" name="customer_name" class="ml-2 form-control customer-name">
                           </div>
                           
                            <div class="input-group">
                                <label class="mt-2" for="customer-detail1">تیلیفون  :</label>
                           <input type="text" form="data_for_invoice" id="customer-detail1" name="customer_contact" class="ml-2 form-control customer-detail1">
                            </div>
                          <div class="input-group">
                            <label class="mt-2" for="customer-detail2">ایمیل  :</label>
                            <input type="text" form="data_for_invoice" id="customer-detail2" name="customer_email" class=" ml-2 form-control customer-detail2">
                          </div>
                        </div>
                    </div>
            </div>
            <div class="row">
                <div class="search-bar">
               
                        <input type="search"  placeholder="جستجوی اجناس" list="search_list" id="myinput" name="item-search"  class="print item-search form-control">
                </div>
            </div>
            <datalist id="search_list">
                <% data_03.forEach(function(item_reg) {  %>
                    <option value="<%= item_reg.id %>"><%= item_reg.item_name %></option>
                    <% }); %>
            </datalist>
            <div class="row">
                <form class="col-sm-12 mt-5" action="" enctype="multipart/form-data" id="data_for_invoice" autocomplete="off">
                    
                <table class="table table-striped table-bordered" id="table-man">
                    <thead>
                        <tr>
                            <th>شماره ثبت</th>
                            <th>نام جنس</th>
                            <th> نوع جنس</th>
                            <th>مقدار</th>
                            <th>قیمت</th>
                            <th>مجموع</th>
                            <th class="print">حذف</th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        
                    </tbody>
                </table>
               <div class="calclus">
                <div class="input-group">
                    <label class="mt-2" for="quantity-show">مجموعه   :</label>
                    <input type="number" value="" readonly name="total_show" id="quantity-show" class="quantity-show form-control ml-2 mb-2">
                   </div>
    
                 <div class="input-group">
                    <label class="mt-2" for="reciept-show">مقدار  رسید :</label>
                    <input type="number" value="" name="reciept_show" id="reciept-show" class="reciept-show  form-control  ml-2 mt-2 mb-2">
                 </div>
                       <input type="hidden" value="<%= data_04 +1 %>" id="bill_no" name="bill_no">
                    <div class="input-group">
                        <label class="mt-2" for="total-show">باقی :</label>
                    <input type="number" value="" readonly name="remain_show" id="total-show" class="total-show  form-control ml-2  mt-2 mb-2">
                     </div>
                     <div class="input-group">
                        <label class="mt-2" for="currency" >واحد پولی  :</label>
                        <select type="number" id="currency" name="currency" onchange="change_c()" required class="currency mb-3 col-12 form-control">
                      <option value="دالر">دالر</option>      
                      <option value="کلدار">کلدار</option>      
                      <option value="تومان">تومان</option>      
                      <option value="یورو">یورو</option>      
                      <option value="افغانی">افغانی</option>      
                      </select>
                      <!-- for making currecny visible -->
                      <script>
                          function change_c(){
                            var exchangeRate = $("#currency").val();
                            if(exchangeRate == "دالر"){
                                $("#to_dollar").val(localStorage.getItem(1));
                            }
                            else if(exchangeRate == "یورو"){
                                $("#to_dollar").val(localStorage.getItem(2));
                            }
                            else if(exchangeRate == "افغانی"){
                                $("#to_dollar").val(1);
                            }
                            else if(exchangeRate == "کلدار"){
                                $("#to_dollar").val(localStorage.getItem(3));
                            }
                            else if(exchangeRate == "تومان"){
                                $("#to_dollar").val(localStorage.getItem(4));
                            }
                          }
                        </script>
                     
                      </div>
                     <div class="input-group">
                        <label class="mt-2" for="to_dollar" >به دالر :</label>
                        <input type="text" id="to_dollar" name="to_dollar" required class="to_dollar mb-3 col-12 form-control">
                      </div>

                </div>
              <div class=" oprs">
                <input onclick="setlocalStoage()" type="submit" id="save" name="save" class="save btn btn-success rounded-pill col-3 mx-auto ml-5 mb-5 print" value="ذخیره کردن">
                <a class="print" onclick="javascript:window.print();"><img class="ml-5 mb-5 btn btn-primary" style="cursor: pointer;"  width="40px" src="assets/img/mawadkham/print.svg" alt="print"></a>
              </div>
            <!-- </form> -->
            <div class="col-sm-3"><a style="color: #fff;" href="froshat_view.ejs" class="btn btn-sm btn-success">معومات ثبت شده</a></div>

            </div>

        </form>
            <script>
                function setlocalStoage(){
      var owner_name = $("#owner_name").val();
      var owner_detail1 = $("#owner_detail1").val();
      var owner_detail2 = $("#owner_detail2").val();
      localStorage.setItem(5,owner_name);
      localStorage.setItem(6,owner_detail1);
      localStorage.setItem(7,owner_detail2);

                }
                $('#owner_name').val(localStorage.getItem(5));
                $('#owner_detail1').val(localStorage.getItem(6));
                $('#owner_detail2').val(localStorage.getItem(7));
                // alert(localStorage.getItem(7));
                $('#total-show').val();
                $('#quantity-show').on('keyup',()=>{
                    $('#total-show').val($('#quantity-show').val()-$('#reciept-show').val()); 
                });
                $('#reciept-show').on('keyup',()=>{
                    $('#total-show').val($('#quantity-show').val()-$('#reciept-show').val()); 
                });
                
                //for remain update
                // $('#total-show').val();
                // $('#quantity-show').on('keyup',()=>{
                //     $('#total-show').val($('#quantity-show').val()-$('#reciept-show').val()); 
                // });
                // $('#reciept-show').on('keyup',()=>{
                //     $('#total-show').val($('#quantity-show').val()-$('#reciept-show').val()); 
                // });

            </script>
            <!-- </form> -->
    </div>
 </div>
 
