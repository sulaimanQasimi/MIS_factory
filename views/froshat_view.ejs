                                // Decode URL encoding if present
                                companyInfo.logo = decodeURIComponent(companyInfo.logo);
                                
                                if (companyInfo.logo.startsWith('http')) {
                                    // Already a full URL, keep as is
                                } else if (companyInfo.logo.startsWith('/')) {
                                    // Already absolute from root, keep as is
                                } else if (companyInfo.logo.startsWith('assets/') || companyInfo.logo.startsWith('Images/')) {
                                    // Already has path prefix, make absolute
