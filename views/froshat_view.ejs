                    const description = $('#payment_description').val() || 'پرداخت';
                    
                    // Validation
                    if (!date || !amount) {
                        Utils.showError('لطفا تاریخ و مقدار پرداخت را وارد کنید!');
                        return false;
                    }
                    
                    if (parseFloat(amount) <= 0) {
                        Utils.showError('مقدار پرداخت باید بیشتر از صفر باشد!');
                        return false;
                    }
                    
                    const loading = Utils.showLoading('در حال ثبت...');
                    
                    Utils.ajaxRequest({
                        url: '/add_output_sales?incoming_loan_id=' + billId + '&amount=' + amount + '&currency=' + currency + '&ex_rate=' + exRate + '&date=' + date + '&description=' + encodeURIComponent(description),
