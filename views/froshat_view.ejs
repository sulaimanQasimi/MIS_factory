  <script>
    function change_c() {
      var exchangeRate = $("#currency").val();
      if(exchangeRate == "دالر"){
        $("#ex_rate").val(1);
        $("#dynamic_ex_rate").text("💱 نرخ به دالر:");
      } else if(exchangeRate == "افغانی"){
        $("#ex_rate").val(localStorage.getItem(1) || 66.5);
        $("#dynamic_ex_rate").text("💱 نرخ به افغانی:");
      }
    }
    
    // Initialize date picker
    $(function() {
      $('#date_man').datepicker({
        changeMonth: true,
        changeYear: true
      });
    });
  </script>
