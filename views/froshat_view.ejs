    <!-- JavaScript -->
    <script>
        /**
         * Sales Bills View - Main JavaScript Module
         * Handles all interactions for the sales bills view page
         */
        (function() {
            'use strict';
            
            // Configuration
            const CONFIG = {
                AJAX_TIMEOUT: 15000,
                PRINT_WINDOW_SIZE: { width: 900, height: 700 }
            };
            
            // State management
            const state = {
                billDetailsCache: {},
                toggleCount: 2
            };
            
            /**
             * Utility Functions
             */
            const Utils = {
                /**
                 * Show loading overlay
                 */
                showLoading: function(message) {
                    const overlay = $('<div>').addClass('loading-overlay').html('<i class="fa fa-spinner fa-spin"></i> ' + (message || 'در حال بارگذاری...'));
                    $('body').append(overlay);
                    return overlay;
                },
                
                /**
                 * Hide loading overlay
                 */
                hideLoading: function(overlay) {
                    if (overlay) overlay.remove();
                },
                
                /**
                 * Show error message
                 */
                showError: function(message) {
                    alert('❌ ' + message);
                },
                
                /**
                 * Show success message
                 */
                showSuccess: function(message) {
                    alert('✅ ' + message);
                },
                
                /**
                 * Make AJAX request with error handling
                 */
                ajaxRequest: function(options) {
                    const defaults = {
                        type: 'POST',
                        async: true,
                        cache: false,
                        contentType: false,
                        processData: false,
                        timeout: CONFIG.AJAX_TIMEOUT
                    };
                    
                    return $.ajax($.extend({}, defaults, options));
                },
                
                /**
                 * Clean HTML for print (remove interactive elements)
                 */
                cleanHtmlForPrint: function(html) {
                    if (!html || html.trim() === '') return '';
                    const $temp = $('<div>').html(html);
                    $temp.find('button, [onclick], a, th').remove();
                    return $temp.html();
                }
            };
            
            /**
             * Exchange Rate Handler
             */
            const ExchangeRateHandler = {
                init: function() {
                    $('#currency').on('change', this.updateRate.bind(this));
                    this.updateRate();
                },
                
                updateRate: function() {
                    const currency = $('#currency').val();
                    const $exRate = $('#ex_rate');
                    const $label = $('#dynamic_ex_rate');
                    
                    if (currency === 'دالر') {
                        $exRate.val(1);
                        $label.text('💱 نرخ به دالر:');
                    } else if (currency === 'افغانی') {
                        $exRate.val(localStorage.getItem(1) || 66.5);
                        $label.text('💱 نرخ به افغانی:');
                    }
                }
            };
            
            /**
             * Date Picker Initialization
             */
            const DatePickerHandler = {
                init: function() {
                    $('.date-man, #date_man, #date_man1, #date_man4').datepicker({
                        changeMonth: true,
                        changeYear: true
                    });
                }
            };
            
            /**
             * Bill Details Handler
             */
            const BillDetailsHandler = {
                /**
                 * Load bill details when expanding
                 */
                loadDetails: function(billId) {
                    const $container = $('#bill_details_' + billId);
                    const cached = state.billDetailsCache[billId];
                    
                    // Check cache
                    if (cached && $container.html().trim() !== '' && !$container.html().includes('در حال بارگذاری')) {
                        this.toggleIcon(billId);
                        return;
                    }
                    
                    // Show loading
                    $container.html('<tr><td colspan="8" style="text-align:center; padding: 20px;"><i class="fa fa-spinner fa-spin"></i> در حال بارگذاری...</td></tr>');
                    
                    Utils.ajaxRequest({
                        url: '/sending_details?param=' + billId,
                        type: 'GET',
                        success: function(data) {
