  <script>
    function from_to_date()
              {
                    var from_date =  $("#date_man4").val();
                    var to_date =$("#date_man1").val();
                   
                      $.ajax({
                        url: '/searching_bill_no?from_date='+from_date+'&to_date='+to_date,
