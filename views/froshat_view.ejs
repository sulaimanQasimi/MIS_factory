  <script>
    function from_to_date()
              {
                    var from_date =  $("#date_man4").val();
                    var to_date =$("#date_man1").val();
                   
                      $.ajax({
                        url: '/searching_bill_no?from_date='+from_date+'&to_date='+to_date,
                            type: 'POST',
                            async: false,
                            cache: false,
                            contentType: false,
                            processData: false,
                            success: function (data) {
                             $("#myTable").html(data);
                              
                            },
                            error: function(data){
                                alert(data);
                            }
                        });
                        return false;
              }

function delete1(id)
              {
                var result = confirm('are you sure ?');
                if(result == true)
                {
                  var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/froshat_view_delete?param='+id,                    
                        success: function(data) {
                          alert(data);
                           window.location.href= "froshat_view.ejs";
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                            alert("خطا در حذف اطلاعات");
                        }
                        });
                }
              }

                      function update_froshat(id)
                          {
                           
                            var data ={};
                                $.ajax({
                                    type: 'POST',
                                    data: JSON.stringify(data),
                                    contentType: "application/json",
                                    dataType:'json',
                                    url: '/update_froshat_view?param='+id,                      
                                    success: function(data) {
                                      var obj_to_staring = JSON.stringify(data);
                                      var string_to_object = JSON.parse(obj_to_staring);
                                      var shamsi_date = string_to_object.data;
                                      var name1 = string_to_object.data1;
                                      var pars2 = JSON.parse(name1);

                                      var expense_id= pars2.id;
                                      var company_name= pars2.company_name;
                                      var paid_amount = pars2.paid_amount;
                                     
                                      var total_amount= pars2.total_amount;
                                      var remain = parseFloat(total_amount) - parseFloat(paid_amount);
                                      var currency = pars2.currency;
                                      var ex_rate = pars2.ex_rate;
                                      
                                     
                                      $("#sales_id").val(expense_id);
                                      $("#company_name").val(company_name);
                                      $("#paid_amount").val(paid_amount);
                                      $("#remain").val(remain);
                                      $("#currency1").val(currency);
                                      $("#ex_rate1").val(ex_rate);
                                      
                                    
                                      
                                      $("#data_man1").val(shamsi_date);
                                    },
                                    error: function(error) {
                                        console.log("some error in fetching the notifications");
                                    }
                                    });
              }
                      
                      
  </script>

<script>
                var count = 2;
                
                function change_icon(id){
                    $("#bill_details_"+id).html("<tr><td colspan='7' style='text-align:center;'><i class='fa fa-spinner fa-spin'></i> در حال بارگذاری...</td></tr>");
                    
                    console.log("Loading bill items for bill ID:", id);
                                           
                            $.ajax({
                                    url: '/sending_details?param='+id,
                            type: 'POST',
                            async: false,
                                    cache: false,
                                    contentType: false,
                                    processData: false,
                                    success: function (data) {
                                        console.log("Bill items response:", data);
                                        if(data && data.trim() !== '') {
                                            $("#bill_details_"+id).html(data);
                                        } else {
                                            $("#bill_details_"+id).html("<tr><td colspan='7' style='text-align:center; color:gray;'>هیچ آیتمی ثبت نشده است</td></tr>");
                                        }
                                    },
                                    error: function(xhr, status, error) {
                                        console.error("Error loading bill details:", error);
                                        console.error("Response:", xhr.responseText);
                                        console.error("Status:", xhr.status);
                                        var errorMsg = "خطا در بارگذاری آیتم ها";
                                        if(xhr.responseText) {
                                            errorMsg += ": " + xhr.responseText.substring(0, 100);
                                        }
                                        $("#bill_details_"+id).html("<tr><td colspan='7' style='text-align:center; color:red;'>" + errorMsg + "</td></tr>");
                                    }
                                  });

                  $("#"+id).css({"transition-duration":"1s"});
                  if(count%2 == 0){
                    slide_up(id);
                  }
                  else{
                    slide_down(id);
                  }
                  count++;


                }
                function slide_up(id){
                  $("#"+id).css({"transform":"rotate(180deg)"});
                
                }
                function slide_down(id){
                  $("#"+id).css({"transform":"rotate(360deg)"});
                
                }
</script>

