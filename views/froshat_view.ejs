                /**
                 * Toggle expand/collapse icon
                 */
                toggleIcon: function(billId) {
                    const $icon = $('#' + billId);
                    $icon.css({'transition-duration': '1s'});
                    
                    if (state.toggleCount % 2 === 0) {
                        $icon.css({'transform': 'rotate(180deg)'});
