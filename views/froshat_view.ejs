    <style>
        /* Table Styles */
        .head th, .head td {
            width: 100px;
        }
        
        #tr1 th {
            position: sticky !important;
            top: 0px !important;
            background-color: dodgerblue;
        }
        
        table {
            margin-top: 20px;
            padding: 20px;
        }
        
        /* Button Styles */
        .print-tbl {
            transition: all 0.3s ease;
        }
        
        .print-tbl:hover {
            background: #138496 !important;
            transform: scale(1.1);
        }
        
        .edt {
            transition: all 0.2s ease;
            margin: 2px;
        }
        
        .edt:hover {
            transform: scale(1.1);
            opacity: 0.8;
        }
        
        /* Animations */
        @keyframes fadeIn {
            from { 
                opacity: 0; 
                transform: translateY(-10px); 
            }
            to { 
                opacity: 1; 
                transform: translateY(0); 
            }
        }
        
        .card {
            animation: fadeIn 0.3s ease-in;
        }
        
        /* Loading Indicator */
        .loading-overlay {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 20px 40px;
            border-radius: 10px;
            z-index: 10000;
            font-size: 16px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 40px;
            color: #666;
        }
        
        .empty-state i {
            font-size: 24px;
            margin-bottom: 10px;
            display: block;
        }
    </style>
</head>
