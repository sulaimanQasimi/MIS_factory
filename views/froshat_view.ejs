                            console.error('Error loading bill items:', {billId: billId, status: status, error: error, responseText: xhr.responseText});
                            let errorMsg = 'خطا در بارگذاری آیتم ها';
                            if (status === 'timeout') {
                                errorMsg = 'زمان بارگذاری به پایان رسید. لطفا دوباره تلاش کنید.';
                            } else if (xhr.status === 404) {
                                errorMsg = 'مسیر درخواست یافت نشد. لطفا صفحه را بروزرسانی کنید.';
                            } else if (xhr.status === 500) {
                                errorMsg = 'خطای سرور: ' + (xhr.responseText || error);
                            }
                            $container.html('<tr><td colspan="8" style="text-align:center; color:red; padding: 20px;"><i class="fa fa-exclamation-triangle"></i> ' + errorMsg + '</td></tr>');
