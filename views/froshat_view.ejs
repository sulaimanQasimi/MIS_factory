                 * Search bills by date range
                 */
                searchByDate: function() {
                    const fromDate = $('#date_man4').val();
                    const toDate = $('#date_man1').val();
                    
                    if (!fromDate || !toDate) {
                        Utils.showError('لطفا تاریخ شروع و پایان را وارد کنید!');
                        return false;
                    }
                    
                    $('#myTable').html('<tr><td colspan="11" style="text-align:center; padding: 30px;"><i class="fa fa-spinner fa-spin"></i> در حال جستجو...</td></tr>');
                    
                    Utils.ajaxRequest({
                        url: '/searching_bill_no?from_date=' + encodeURIComponent(fromDate) + '&to_date=' + encodeURIComponent(toDate),
                        success: function(data) {
                            if (data && data.trim() !== '') {
                                $('#myTable').html(data);
                                $('[data-toggle="tooltip"]').tooltip();
                            } else {
                                $('#myTable').html('<tr><td colspan="11" style="text-align:center; padding: 30px; color: gray;">هیچ بل در این بازه زمانی یافت نشد</td></tr>');
                            }
                        },
                        error: function(xhr, status, error) {
                            let errorMsg = 'خطا در جستجو';
                            if (status === 'timeout') {
                                errorMsg = 'زمان جستجو به پایان رسید. لطفا دوباره تلاش کنید.';
                            }
                            Utils.showError(errorMsg);
                            $('#myTable').html('<tr><td colspan="11" style="text-align:center; padding: 30px; color: red;"><i class="fa fa-exclamation-triangle"></i> ' + errorMsg + '</td></tr>');
                        }
                    });
                    
                    return false;
                },
                
                /**
                 * Filter table by search input
                 */
                filterTable: function() {
                    $('#myInput').on('keyup', function() {
                        const value = $(this).val().toLowerCase();
                        $('#myTable tr').filter(function() {
                            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                        });
                    });
                }
            };
            
            /**
             * Form Handlers
             */
            const FormHandler = {
                /**
                 * Initialize form submissions
                 */
                init: function() {
                    // Payment form
                    $('#add_pays1').on('click', PaymentHandler.addPayment);
                    $('#update').on('click', PaymentHandler.updatePayment);
                    
                    // Edit form
                    $('#form_1').on('submit', function(e) {
                        e.preventDefault();
                        Utils.ajaxRequest({
                            url: '/updated_froshats',
                            type: 'POST',
                            data: $(this).serialize(),
                            success: function(response) {
                                Utils.showSuccess(response);
                                window.location.href = 'froshat_view.ejs';
                            },
                            error: function(error) {
                                Utils.showError('خطا در بروزرسانی');
                            }
                        });
                    });
                    
                    // Bill update form
                    $('#update_bill').on('submit', function(e) {
                        e.preventDefault();
                        const bilId = $('#bil_id').val();
                        const froId = $('#fro_id').val();
                        const quantity = $('#quantity').val();
                        const price = $('#price').val();
                        const itemName = $('#item_name').val();
                        const itemType = $('#item_type').val();
                        const thickness = $('#thickness').val() || 0;
                        
                        Utils.ajaxRequest({
                            url: '/update_bills_01?bil_id=' + bilId + '&fro_id=' + froId + '&quantity=' + quantity + '&price=' + price + '&item_name=' + itemName + '&item_type=' + itemType + '&thickness=' + thickness,
                            success: function(data) {
                                $('#basicModal').modal('hide');
                                Utils.showSuccess('اطلاعات با موفقیت بروزرسانی شد');
                            },
                            error: function(error) {
                                Utils.showError('خطا در بروزرسانی');
                            }
                        });
                        
                        return false;
                    });
                }
            };
            
            /**
             * Event Delegation - Handle dynamic button clicks
             */
            const EventHandler = {
                init: function() {
                    // Delete bill
                    $(document).on('click', '.btn-delete', function() {
                        const billId = $(this).data('bill-id');
                        BillHandler.deleteBill(billId);
                    });
                    
                    // Edit bill
                    $(document).on('click', '.btn-edit', function() {
                        const billId = $(this).data('bill-id');
                        BillHandler.editBill(billId);
                    });
                    
                    // Add payment
                    $(document).on('click', '.btn-add-payment', function() {
                        const billId = $(this).data('bill-id');
                        PaymentHandler.openModal(billId);
                    });
                    
                    // Print bill
                    $(document).on('click', '.btn-print', function() {
                        const billId = $(this).data('bill-id');
                        BillHandler.printBill(billId);
                    });
                    
                    // Toggle bill details
                    $(document).on('click', '.btn-toggle-details', function() {
                        const billId = $(this).data('bill-id');
                        BillDetailsHandler.loadDetails(billId);
                    });
                    
                    // Payment operations (delegated from server-rendered HTML)
                    $(document).on('click', '[data-action="edit-payment"]', function() {
                        const paymentId = $(this).data('payment-id');
                        PaymentHandler.editPayment(paymentId);
                    });
                    
                    $(document).on('click', '[data-action="delete-payment"]', function() {
                        const paymentId = $(this).data('payment-id');
                        PaymentHandler.deletePayment(paymentId);
                    });
                    
                    // Search by date
                    $('input[value="جستجو"]').on('click', SearchHandler.searchByDate);
                }
            };
            
            /**
             * Initialize Application
             */
            const App = {
                init: function() {
                    // Initialize all modules
                    ExchangeRateHandler.init();
                    DatePickerHandler.init();
                    SearchHandler.filterTable();
                    FormHandler.init();
                    EventHandler.init();
                    
                    // Initialize tooltips
                    $('[data-toggle="tooltip"]').tooltip();
                    
                    // Handle window resize for iframe
                    if (document.getElementById('iframe')) {
                        const updateIframeHeight = function() {
                            const screenHeight = $(window).height();
                            const heightWithoutNav = screenHeight - 60;
                            document.getElementById('iframe').style.height = heightWithoutNav + 'px';
                        };
                        updateIframeHeight();
                        $(window).on('resize', updateIframeHeight);
                    }
                    
                    // Global AJAX error handler
                    $(document).ajaxError(function(event, xhr, settings, thrownError) {
                        console.error('AJAX Error:', {
                            url: settings.url,
                            status: xhr.status,
                            error: thrownError
                        });
                    });
                    
                    // Log loaded bills count
                    const billCount = $('#myTable tr').length;
                    if (billCount > 0) {
                        console.log('Loaded ' + billCount + ' bills');
                    }
                }
            };
            
            // Initialize when DOM is ready
            $(document).ready(function() {
                App.init();
            });
            
            // Expose global functions for backward compatibility
            window.change_c = ExchangeRateHandler.updateRate.bind(ExchangeRateHandler);
            window.delete1 = BillHandler.deleteBill;
            window.update_froshat = BillHandler.editBill;
            window.add_out_loan = PaymentHandler.openModal;
            window.add_payment_input = PaymentHandler.addPayment;
            window.update_data = PaymentHandler.updatePayment;
            window.payment_delet = PaymentHandler.deletePayment;
            window.payment_edit = PaymentHandler.editPayment;
            window.change_icon = function(id) {
                BillDetailsHandler.loadDetails(id);
            };
            window.print_bill_details = BillHandler.printBill;
            window.from_to_date = SearchHandler.searchByDate;
            window.cat_edit = function(id) {
                Utils.ajaxRequest({
                    url: '/update_bill_details?param=' + id,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({}),
                    dataType: 'json',
                    success: function(data) {
                        try {
                            const parsed = JSON.parse(JSON.stringify(data).substring(1, JSON.stringify(data).length - 1));
                            $('#bil_id').val(parsed.id);
                            $('#fro_id').val(parsed.bill_id);
                            $('#item_name').val(parsed.item_name);
                            $('#item_type').val(parsed.item_type);
                            $('#quantity').val(parsed.quantity);
                            $('#price').val(parsed.price);
                            // Thickness is already converted to cm by the backend, so display as-is
                            $('#thickness').val(parsed.thickness || 0);
                            $('#basicModal').modal('show');
                        } catch (e) {
                            console.error('Error parsing bill detail:', e);
                        }
                    },
                    error: function(error) {
                        console.error('Error fetching bill detail:', error);
                    }
                });
            };
            window.update_bills = function() {
                $('#update_bill').submit();
            };
            window.cat_delet1 = function(id) {
                if (!confirm('آیا از حذف این آیتم مطمئن هستید؟')) {
                    return;
                }
                Utils.ajaxRequest({
                    url: '/add_payment_delete_004?bill_detail_id=' + id,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({}),
                    dataType: 'json',
                    success: function(data) {
                        Utils.showSuccess('اطلاعات موفقانه حذف گردید');
                        window.location.href = 'froshat_view.ejs';
                    },
                    error: function(error) {
                        Utils.showSuccess('اطلاعات موفقانه حذف گردید');
                        window.location.href = 'froshat_view.ejs';
                    }
                });
            };
        })();
    </script>
</body>
</html>
