      <script>
        
        var count = 1;
      $("#item-search").on("search",function(){
                var search_input = $("#item-search").val();
          
                        var data ={};
                                   
                              $.ajax({
                                  type: 'POST',
                                  data: JSON.stringify(data),
                                  contentType: "application/json",
                                  dataType:'json',
                                  url: '/mahsol_items?param='+search_input,                      
                                  success: function(data) {

                                   //alert(data);
                     
                                  var js_arr = JSON.stringify(data);
                                  var str_array = js_arr.split(',');

                                  var newStr = js_arr.substring(1, js_arr.length-1);
                                  var parsedJSON = JSON.parse(newStr);
                                  var st_id = parsedJSON.id;
                                 
                                   
                          var name = parsedJSON.item_name;
                          var quantity= 1;
                         // var buy_type = parsedJSON.item_type;
                          var price = parsedJSON.price;
                          var total = price * quantity ;
                   
                                   /*  $("#item-search").on("search",function()
                                    { */
                                        
                                            var html_code = "<tr id='row_id_"+count+"'>";

                                            html_code+=
                                            '<td>'+count+'</td>';
                                            html_code+=
                                            '<td><input type="text" name="item" value="'+name+'" class="form-control item" id="item"></td>';
                                            html_code+=
                                            '<td><input type="number" name="quantity" value="'+quantity+'" class="form-control quantity" id="quantity_'+count+'"></td>';
                                            html_code+=
                                            '<td><input type="number" name="price" value="'+price+'"  class="form-control price" id="price_'+count+'"></td>';
                                            html_code+=
                                            '<td><input type="number" name="total" value="'+total+'" readonly class="form-control total" id="total_'+count+'"></td>';
                                            html_code+=
                                            '<td class="print"><span class="delete-img print"  id="'+count+'" ><img width="25px" style="cursor: pointer;" src="assets/img/mawadkham/trash.svg" alt=""></span></td>';
                                            html_code += "</tr>";
                                            
                                            $("#tbody").append(html_code);
                                            count++;

                                     
                                        },

                                        error: function(error) {
                                          
                                            console.log("some error in fetching the notifications");
                                        } 
                             
              
                });
         });
      
      </script>
