  <script>
          $(function(){
            var exchangeRate = $("#expense_type").val();
            if(exchangeRate == "دالر"){
                $("#nerkh").val(localStorage.getItem(1));
            }
            else if(exchangeRate == "یورو"){
                $("#nerkh").val(localStorage.getItem(2));
            }
            else if(exchangeRate == "افغانی"){
                $("#nerkh").val(1);
            }
            else if(exchangeRate == "کلدار"){
                $("#nerkh").val(localStorage.getItem(3));
            }
            else if(exchangeRate == "تومان"){
                $("#nerkh").val(localStorage.getItem(4));
            }
          });
  </script>
