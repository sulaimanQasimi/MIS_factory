        <script>

const $form = $('#update_iloan_reg1')
      $form.on('submit', submitHandler)
      
      function submitHandler (e) {
        e.preventDefault()
      
        $.ajax({
          url: '/update_inloan_reg',
          type:'POST',
          data: $form.serialize()
        }).done(response => {
          console.log(response)
