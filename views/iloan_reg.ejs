        <script>

function delete1(id)
              {
                var result = confirm('are you sure ?');
                if(result == true)
                {
                  var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/delete_income_loans?param='+id,                      
                        success: function(data) {
                           window.location.href= "iloan_reg.ejs";
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
                 }
              }

              function add_input_loan(id)
              {
                
                $("#edit_id").val(id);
              
                $.ajax({
                    url: '/show_all_payment?each_loaner_id='+id,
                    type: 'POST',
                    //data: formData,
                    async: false,
                    cache: false,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                    // alert("hello success ");
                        /* $("#expens_tble").html(data); */
                        $("#myTable_payment").html(data);
                      //document.getElementById("form2").reset();
                    },
                    error: function(data){
                        alert(data);
                    }
                });
                return false;
              }
              

              function add_payment_input()
              {

                    var id = $("#edit_id").val();
                    var amount =  $("#amount").val();
                    var currency =$("#currency").val();
                    var ex_rate = $("#ex_rate").val();
                    var date =    $("#date_man").val();
                    if(date == "" || amount =="")
                    {
                      alert("تاریخ و مقدار پرداخت");
                    }else{

                            $.ajax({
                              url: '/add_input_loan?incoming_loan_id='+id+'&amount='+amount+'&currency='+currency+'&ex_rate='+ex_rate+'&date='+date,
                                  type: 'POST',
                                  //data: formData,
                                  async: false,
                                  cache: false,
                                  contentType: false,
                                  processData: false,
                                  success: function (data) {
                                  // alert("hello success ");
                                    /*  $("#expens_tble").html(data); */
                                    $("#myTable_payment").html(data);
                                    window.location.href= "iloan_reg.ejs";
                                  },
                                  error: function(data){
                                      alert(data);
                                  }
                              });
                              return false;
                          }
              }

              function update_incom_loan(id)
              {
                var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/update_income_loan?param='+id,                      
                        success: function(data) {
                          var obj_to_staring = JSON.stringify(data);//always server data is coming in object type we have to converted in string

                           var string_to_object = JSON.parse(obj_to_staring);//for accessing the value of key we have to convert to object
                           var shamsi_date = string_to_object.data;//our first part of data converted to object so we can access the value
                           var name1 = string_to_object.data1;//our second part of data still in string type so we again convt to obj

                           var pars2 = JSON.parse(name1);//here we have parse(convrt to obj) it again,because second parts was nested string

                          var expense_id= pars2.id;
                          var borrower= pars2.borrower;
                          var lender =  pars2.lender;
                          var amount= pars2.amount;
                          var installment_no = pars2.installment_no;
                          var lender_contact = pars2.lender_contact;
                          var address = pars2.address;
                          
                          var currency = pars2.currency;
                          var ex_rate = pars2.ex_rate;
                          var benefit = pars2.benefit;
                         
                          
                          $("#expense_id").val(expense_id);
                          $("#borrower").val(borrower);
                          $("#lender").val(lender);
                          $("#loan_amount").val(amount);//amount
                          $("#installment_no").val(installment_no);
                          $("#lender_contact").val(lender_contact);
                          $("#address").val(address);
                          $("#loan_currency").val(currency);
                          $("#loan_ex_rate").val(ex_rate);
                          $("#benefit").val(benefit);
                         
                          $("#data_man").val(shamsi_date);
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
              }

              function payment_delet(id)
                    { 
                      var loan_id = $("#edit_id").val();
                      var result = confirm('are you sureh ?');
                          if(result == true)
                          {
                            $("#delete_row_"+id).hide();
                            var data ={};
                              $.ajax({
                                  type: 'POST',
                                  data: JSON.stringify(data),
                                  contentType: "application/json",
                                  dataType:'json',
                                  url: '/add_payment_delete?param='+id+"&loan_id="+loan_id,                      
                                  success: function(data) {
                                    alert(data);
                                    //$("#myTable_payment").html(data);
                                    //$("#myTable_payment").load(window.location.href+"#myTable_payment");
                                  },
                                  error: function(error) {
                                      console.log("some error in fetching the notifications");
                                  }
                                  });
                          }
                    }
                    $("#update").css({"display":"none"});
                    function payment_edit(id)
                    { 
                      
                      $("#update").show();
                      var data ={};
                         $.ajax({
                              type: 'POST',
                              data: JSON.stringify(data),
                              contentType: "application/json",
                              dataType:'json',
                              url: '/iloan_payment_edit1?param='+id,                      
                              success: function(data) {
                                var obj_to_staring = JSON.stringify(data);
                                var string_to_object = JSON.parse(obj_to_staring);
                                var shamsi_date = string_to_object.data;
                                var name1 = string_to_object.data1;
                                var pars2 = JSON.parse(name1);
                                
                                var loan_id = pars2.id;
                                var paid = pars2.paid;
                                
                                var currency = pars2.currency;
                                var ex_rate= pars2.ex_rate;

                                $("#display_edit_id").val(loan_id);
                                $("#amount").val(paid);
                                $("#currency").val(currency);
                                $("#ex_rate").val(ex_rate);
                                $("#date_man").val(shamsi_date);
                                
                              },
                              error: function(error) {
                                  console.log("some error in fetching the notifications");
                              }
                              });
                    }

                    function update_data()
                         { 
                            var id = $("#display_edit_id").val();
                            var amount = $("#amount").val();
                            var currency = $("#currency").val();
                            var ex_rate = $("#ex_rate").val();
                            var date_man = $("#date_man").val();
                            var loan_id = $("#edit_id").val();

                            if(date_man == "" || amount =="")
                            {
                            alert("تاریخ و مقدار پرداخت");
                            }else{

                                    $.ajax({
                                          url: '/update_show_edit1?id_val='+id+"&amount="+amount+"&currency="+currency+"&ex_rate="+ex_rate+"&date_man="+date_man+"&loan_id="+loan_id,
                                          type: 'POST',
                                          //data: formData,
                                          async: false,
                                          cache: false,
                                          contentType: false,
                                          processData: false,
                                          success: function (data) {
                                          // alert("hello success ");
                                          $("#myTable_payment").html(data);
                                          window.location.href= "iloan_reg.ejs";
                                            //document.getElementById("form2").reset();
                                          },
                                          error: function(data){
                                              alert(data);
                                          }
                                      });
                                      return false;
                                 }
                         }

