<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>سیستم مدیریتی</title>
  <!-- style -->
  <link rel="stylesheet" href="assets/css/bootstrap.min.css" />
  <link rel="stylesheet" href="assets/css/bootstrap-rtl.min.css" />
  <link rel="stylesheet" href="assets/css/font-awesome.min.css" />
  <link rel="stylesheet" href="assets/css/jquery-ui.css" />
  <link rel="stylesheet" href="assets/css/main.css" />
  <link rel="stylesheet" href="assets/css/fro.css" />
  <link rel="stylesheet" href="assets/css/persian-datepicker.css">
  <link rel="stylesheet" href="assets/css/dashboard.css" />
  <link rel="stylesheet" href="assets/css/scrollbar.css" />
  <link rel="stylesheet" href="assets/css/responsive.css" />
  <link rel="icon" href="assets/img/co-nav.png" />
  <link href="assets/css/select2.min.css" rel="stylesheet" /> 
  <!-- script -->
  <script src="assets/js/jquery.min.js"></script>
  <script src="assets/js/jquery-ui.js"></script>
  <script src="assets/js/popper.min.js"></script>
  <script src="assets/js/persian-datepicker.js"></script>
  <script src="assets/js/bootstrap.min.js"></script>
  <script src="assets/js/append.js"></script>
  <script src="assets/js/select2.min.js"></script>

</head>
<body>
<!-- start all web -->
<section class="all-web">
    <div class="container-fluid">
        <div class="row">
            <div class="fro-entry col-11 mx-auto">
                <h3 style="color: white; text-align: center; margin-top:40px ;">اضافه نمودن جنس به گدام</h3>
                
                <% data_02.forEach(function(fro_details) {  %>
                <div class="company-brand" style="width: 40%;">
                    <div class="logo">
                        <img width="100%" src="<%= fro_details.logo %>" alt="logo">
                    </div>
                    <div class="title">
                        <h3 style="color: white;"> <%= fro_details.company_name %></h3>
                        <h6 style="color: lightgray;"><%= fro_details.description %> </h6>
                    </div>
                </div>
                <% }); %>
            </div>
      </div>
        </div>
</section>
 <!-- end section all web -->
 <!-- invoice start -->
 <div id="all-invoice" class="all-invoice col-11 mx-auto">
    <div class="container-fluid">
        <div class="row">
            <div class="company-brand">
                <div class="">
                </div>
            </div>
            <div class="blank-spce"></div>
            <div class="detail">
                <% data_02.forEach(function(fro_details) {  %>
                   <div class="owner">
                       <div class="input-group">
                        <label class="mt-2" for="owner_name">نام شرکت :</label>
                        <span><%= fro_details.company_name %></span>
                       </div>
                        <div class="input-group">
                            <label class="mt-2" for="owner_detail1">تیلیفون  :</label>
                       <span><%= fro_details.contact %></span>
                        </div>
                      <div class="input-group">
                        <label class="mt-2" for="owner_detail2">ایمیل  :</label>
                        <span><%= fro_details.email %></span>
                      </div>
                    </div>
                    <% }); %>
            </div>
        </div>
        <div class="row">
            <div class="search-bar">
                <input type="search" placeholder="جستجوی اجناس" list="search_list" id="myinput" name="item-search" class="print item-search form-control">
            </div>
        </div>
        <datalist id="search_list">
            <% data_03.forEach(function(item_reg) {  %>
                <option value="<%= item_reg.id %>"><%= item_reg.item_name %> -- <%= item_reg.item_type %> </option>
            <% }); %>
        </datalist>
        <div class="row">
            <form class="col-sm-12 mt-5" action="" enctype="multipart/form-data" id="data_for_invoice" autocomplete="off">
                <table class="table table-striped table-bordered" id="table-man">
                    <thead>
                        <tr>
                            <th>شماره ثبت</th>
                            <th>نام جنس</th>
                            <th>واحد</th>
                            <th>قیمت ثابت</th>
                            <th>قیمت فروش</th>
                            <th>مقدار (M³)</th>
                            <th>ضخامت</th>
                            <th>باقیمانده</th>
                            <th class="print">حذف</th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        
                    </tbody>
                </table>
               <div class="calclus">
                <div class="input-group">
                    <label class="mt-2" for="date_income">تاریخ   :</label>
                    <input type="text" value="" required name="date_income" id="date_income" class="date_man form-control ml-2 mb-2">
                </div>
                </div>
              <div class=" oprs">
                <input onclick="setlocalStoage()" type="submit" id="save" name="save" class="save btn btn-success rounded-pill col-3 mx-auto ml-5 mb-5 print" value="ذخیره کردن">
                <a class="print" onclick="javascript:window.print();"><img class="ml-5 mb-5 btn btn-primary" style="cursor: pointer;" width="40px" src="assets/img/mawadkham/print.svg" alt="print"></a>
              </div>
            </form>
        </div>
    </div>
 </div>
 
 <!-- invoice end -->
</body>
   <!--common script for all pages-->
    <script src="assets/js/script.js"></script>
    <script src="assets/js/common-scripts.js"></script>
    <!--script for this page-->
    <script src="assets/js/sparkline-chart.js"></script>
    <script src="assets/js/easy-pie-chart.js"></script>
    <script src="assets/js/all-chartjs.js"></script>
  <script>
      $(document).ready(function() {
      $('.js-example-basic-single').select2();
    });
      $(function(){
          $('select.styled').customSelect();
      });
  </script>
  <script>
      var count = 1;
      $("#myinput").on("search",function(){
          var search_input = $("#myinput").val();
          
          var data ={};

                $.ajax({
                    type: 'POST',
                    data: JSON.stringify(data),
                    contentType: "application/json",
                    dataType:'json',
                    url: '/get_stack_to_market_list?param='+search_input,                      
                    success: function(data) {
                        var js_arr = JSON.stringify(data);
                        var str_array = js_arr.split(',');
                        
                        var newStr = js_arr.substring(1, js_arr.length-1);
                        var parsedJSON = JSON.parse(newStr);
                        var st_id = parsedJSON.id;
                        var name = parsedJSON.item_name;
                        var item_type = parsedJSON.item_type;
                        var fixed_price = parsedJSON.fixed_price;
                        var sell_price = parsedJSON.sell_price;
                        var thickness = parsedJSON.thickness;
                        var remaining = parsedJSON.remaining;
                        var quantity = 0;
                        
                        var html_code = "<tr id='row_id_"+count+"'>";
                        html_code+= '<td>'+count+'</td>';
                        html_code+= '<td><input type="text" name="item" readonly value="'+name+'" class="form-control item" id="'+count+'"></td>';
                        html_code+= '<input type="hidden" name="stack_to_market_list_id" value="'+st_id+'" id="stack_id_'+count+'">';
                        html_code+= '<td><input type="text" name="type" readonly value="'+item_type+'" class="form-control item" id="'+count+'"></td>';
                        html_code+= '<td><input type="number" name="fixed_price" readonly value="'+fixed_price+'" class="form-control price" id="fixed_price_'+count+'"></td>';
                        html_code+= '<td><input type="number" name="sell_price" readonly value="'+sell_price+'" class="form-control price" id="sell_price_'+count+'"></td>';
                        html_code+= '<td><input type="number" name="quantity" value="'+quantity+'" class="form-control quantity" id="quantity_'+count+'" step="0.001"></td>';
                        html_code+= '<td><input type="number" name="thickness" readonly value="'+thickness+'" class="form-control" id="thickness_'+count+'"></td>';
                        html_code+= '<td><input type="number" name="remaining" readonly value="'+remaining+'" class="form-control" id="remaining_'+count+'"></td>';
                        html_code+= '<td class="print"><span class="delete-img print" id="'+count+'" ><img width="25px" style="cursor: pointer;" src="assets/img/mawadkham/trash.svg" alt=""></span></td>';
                        html_code += "</tr>";
                        
                        $("#tbody").append(html_code);
                        count++;
                        $("#myinput").val("");
                    },
                    error: function(error) {
                        console.log("some error in fetching the notifications");
                    }
                });
      });

      $(document).on('click','.delete-img',function(){
          var row_id = $(this).attr("id");
          $("#row_id_"+row_id).remove();
      });
  </script>
  <script>
      $(document).ready(()=>{
          $(function() {
              $('#date_income').datepicker({
                  changeMonth: true,
                  changeYear: true
              });
          });
      });
  </script>
  <script>
      function setlocalStoage(){
          // Local storage functionality if needed
      }
      
      const $form = $('#data_for_invoice')
      $form.on('submit', submitHandler)

      function submitHandler (e) {
        e.preventDefault()

        $.ajax({
          url: '/save_income',
          type:'POST',
          data: $form.serialize()
        }).done(response => {
          document.getElementById("data_for_invoice").reset();
          console.log(response)
          alert(response);
          window.location.href= "income.ejs";
        })
      }
  </script>
</html>
