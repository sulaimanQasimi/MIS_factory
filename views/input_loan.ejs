          </div>
          <div class="col-sm-12 height" style="height:40px;"></div>
          <div class="col-sm-3"><a style="color: #fff;" href="iloan_reg.ejs" class="btn btn-sm btn-success">معومات ثبت شده</a></div>
          <div class="col-sm-6">
            <input type="submit" class="btn btn-primary rounded-pill" style="width:100%;" value="ذخیره">
          </div>
          <div class="col-sm-3"></div>
        </div>
      </form>
      
        
