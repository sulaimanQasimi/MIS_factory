<body>
    <div class="container">
      <div class="row">
      <section class="all-web" >

        <h3 class="mt-5 mb-5 " style="text-align: center;">قرضه های ورودی</h3>
        <hr>
        <br>
        <form action="" method="post" class="needs-validation"  id="form1">
        <div class="row">
          <div class="col-xs-12 col-sm-12 col-md-10 col-lg-4">
            <div class="input-group">
              <label class="mt-2" for="giranda" > قرضه گیرنده :</label>
              <input  type="text" id="giranda" name="giranda" required class="giranda mb-3 col-12 form-control">
              
            </div>
            <div class="input-group">
              <label class="mt-2" for="dahanda" >قرضه دهنده:</label>
              <input  type="text" id="dahanda" name="dahanda" required class="dahanda mb-3 col-12 form-control">
            </div>
            <div class="input-group">
              <label class="mt-2" for="amount" >مقدار :</label>
              <input  type="number" id="amount" name="amount" required class="amount mb-3 col-12 form-control">
            </div>
            <div class="input-group">
              <label class="mt-2" for="tedad" >تعداد اقساط  :</label>
              <input  type="number" id="tedad" name="tedad" required class="tedad mb-3 col-12 form-control">
            </div>
          </div>
          <!-- second -->
          <div class="col-xs-12 col-sm-12 col-md-10 col-lg-4">
            <div class="input-group">
              <label class="mt-2" for="phone" >شماره قرضه دهنده:</label>
              <input  type="number" id="phone" name="phone" required class="phone mb-3 col-12 form-control">
            </div>
            <div class="input-group">
              <label class="mt-2" for="add" > آدرس :</label>
              <input  type="text" id="add" name="address" required class="add mb-3 col-12 form-control">
            </div>
            <div class="input-group">
              <label class="mt-2" for="currency" >واحد پولی  :</label>
              <select type="number" id="currency" name="currency" onchange="change_c()" required class="currency mb-3 col-12 form-control">
                <option value="افغانی">افغانی</option>      
            <option value="دالر">دالر</option>      
            <option value="کلدار">کلدار</option>      
            <option value="تومان">تومان</option>      
            <option value="یورو">یورو</option>      
            </select>
            <!-- for making currecny visible -->
            <script>
                

                function change_c(){
                  var exchangeRate = $("#currency").val();
                  if(exchangeRate == "دالر"){
                      $("#to_dollar").val(1);
                      $("#dynamic_ex_rate").text("به دالر:");
                  }
                  else if(exchangeRate == "یورو"){
                      $("#to_dollar").val(localStorage.getItem(2));
                      $("#dynamic_ex_rate").text("به یورو:");
                  }
                  else if(exchangeRate == "افغانی"){
                      $("#to_dollar").val(localStorage.getItem(1));
                      $("#dynamic_ex_rate").text("به افغانی:");

                  }
                  else if(exchangeRate == "کلدار"){
                      $("#to_dollar").val(localStorage.getItem(3));
                      $("#dynamic_ex_rate").text("به کلدار:");
                  }
                  else if(exchangeRate == "تومان"){
                      $("#to_dollar").val(localStorage.getItem(4));
                      $("#dynamic_ex_rate").text("به تومان:");
                  }
                }
              </script>
           
            </div>
            <div class="input-group">
              <label class="mt-2" id="dynamic_ex_rate" for="to_dollar" >به افغانی :</label>
              <input readonly type="text" id="to_dollar" name="to_dollar" required class="to_dollar mb-3 col-12 form-control">
            </div>
          </div>
          <!-- third -->
          <div class="col-xs-12 col-sm-12 col-md-10 col-lg-4">
          <div class="input-group">
              <label class="mt-2" for="mafad"  > مفاد</label>
              <input  type="number" id="mafad" name="mafad" required class="mafad mb-3 col-12 form-control">
            </div>
      <div class="input-group">
              <label class="mt-2" for="total" >  مجموعه:</label>
              <input readonly type="number" id="total" name="total" required class="total mb-3 col-12 form-control">
            </div>
            <div class="input-group">
              <label class="mt-2" for="date-man" >تاریخ :</label>
              <input type="text" id="date-man" required name="date_man" class="date-man mb-3 col-12 form-control">
            </div>
           <!-- <div class="input-group">
              <label class="mt-2 " for="emp_img" > تصویر:</label>
               <input type="file"  id="emp_img" name="emp_img" class="emp_img mb-3 col-12 form-control"> 
              <label class="btn mb-3 mt-2 st btn-default btn-sm form-control center-block btn-file">
