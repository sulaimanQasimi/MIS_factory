<script>
    $(document).ready(()=>{
  $(function() {
  $('#date_man').datepicker({
       changeMonth: true,
       changeYear: true
   });
});

function calc_total(){
var total = $('.total');
var mafad = $('.mafad');
var amount = $('.amount');
total.val(parseInt(amount.val())+parseInt(mafad.val()));
}

$('#mafad').keyup(()=>{
  calc_total();
});
$('#amount').keyup(()=>{
  calc_total();
});
    });
</script>

<script>

const $form = $('#form1')
  
  $form.on('submit', submitHandler)
  
  function submitHandler (e) {
    e.preventDefault()
    $.ajax({
      url: '/incoming_loan',
      type:'POST',
      data: $form.serialize()
    }).done(response => {
      console.log(response)
    })
  }
</script>
