        <script>
               const $form = $('#update_ma_reg')
              $form.on('submit', submitHandler)
              
              function submitHandler (e) {
                e.preventDefault()
              
                $.ajax({
                  url: '/udpate_machine_tools_03',
                  type:'POST',
                  data: $form.serialize()
                }).done(response => {
                  console.log(response)
                  window.location.href= "mt_reg.ejs";
                })
              }
          
        </script>
        <script>

          

function delete1(id)
              {
                var result = confirm('are you sure ?');
                if(result == true)
                {
                  var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/delete_machine_tols?param='+id,                      
                        success: function(data) {
                           window.location.href= "mt_reg.ejs";
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
                }
              }

              function update_mt_reg(id)
              {
                var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/update_maching_year?param='+id,                      
                        success: function(data) {
                          var obj_to_staring = JSON.stringify(data);//always server data is coming in object type we have to converted in string

                           var string_to_object = JSON.parse(obj_to_staring);//for accessing the value of key we have to convert to object
                           var shamsi_date = string_to_object.data;//our first part of data converted to object so we can access the value
                           var name1 = string_to_object.data1;//our second part of data still in string type so we again convt to obj

                           var pars2 = JSON.parse(name1);//here we have parse(convrt to obj) it again,because second parts was nested string

                          var expense_id= pars2.id;
                          var name=  pars2.name;
                          var company_name=  pars2.company_name;
                          var description= pars2.description;
                         
                          var quantity = pars2.quantity;
                          var purchase_price = pars2.purchase_price;
                          var machine_life =pars2.machine_life ;
                          
                          var currency = pars2.currency;
                          var ex_rate = pars2.ex_rate;
                         
                          
                          $("#expense_id").val(expense_id);
                          $("#name").val(name);
                          $("#company_name").val(company_name);
                          $("#description").val(description);//amount
                          $("#quantity").val(quantity);
                          $("#purchase_price").val(purchase_price);
                          $("#expire_date").val(machine_life);
                          $("#currency").val(currency);
                          $("#ex_rate").val(ex_rate);
                          // $("#tazkira").val(tazkira);
                         
                          $("#data_man").val(shamsi_date);
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
              }

              function from_to_date()
              {
                       $("#input_laoner").hide();
                   // var id = $("#edit_id").val();
                    var from_date =  $("#date_man").val();
                    var to_date =$("#date_man1").val();
                   
                      $.ajax({
                        url: '/from_date_to_tools_reg_02?from_date='+from_date+'&to_date='+to_date,
                            type: 'POST',
                            //data: formData,
                            async: false,
                            cache: false,
                            contentType: false,
                            processData: false,
                            success: function (data) {
                           //  $(".all_data").hide();
                           alert(data);
                             $(".all_data").html(data);
                              
                            },
                            error: function(data){
                                alert(data);
                            }
                        });
                        return false;
              }
        </script>
