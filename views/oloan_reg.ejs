        <script>
          function delete1(id)
              {
                var result = confirm('are you sure ?');
                if(result == true)
                {
                  var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/delete_outcome_loans?param='+id,                      
                        success: function(data) {
                           window.location.href= "oloan_reg.ejs";
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
                }
              }

              function update_out_loan(id)
              {
                var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/update_out_loan?param='+id,                      
                        success: function(data) {
                          var obj_to_staring = JSON.stringify(data);//always server data is coming in object type we have to converted in string

                           var string_to_object = JSON.parse(obj_to_staring);//for accessing the value of key we have to convert to object
                           var shamsi_date = string_to_object.data;//our first part of data converted to object so we can access the value
                           var name1 = string_to_object.data1;//our second part of data still in string type so we again convt to obj

                           var pars2 = JSON.parse(name1);//here we have parse(convrt to obj) it again,because second parts was nested string

                          var expense_id= pars2.id;
                          var stuff_name= pars2.name;
                          var company_name=  pars2.company_name;
                          var out_amount= pars2.amount;
                          var installment_no = pars2.installment_no;
                          
                          //var address = pars2.address;
                          
                          var currency = pars2.currency;
                          var ex_rate = pars2.ex_rate;
                          var tazkira = pars2.tazkira;
                         // var benefit = pars2.benefit;
                         
                          
                          $("#expense_id").val(expense_id);
                          $("#stuff_name").val(stuff_name);
                          $("#company_name").val(company_name);
                          $("#out_amount").val(out_amount);//amount
                          $("#installment_no").val(installment_no);
                          $("#loan_currency").val(currency);
                          $("#loan_ex_rate").val(ex_rate);
                          $("#tazkira").val(tazkira);
                         
                          $("#data_man").val(shamsi_date);
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
              }

             //open modal
             function add_out_loan(id)
              {
                $("#edit_id").val(id);
              
                $.ajax({
                    url: '/show_all_payment_001?each_loaner_id='+id,
                    type: 'POST',
                    //data: formData,
                    async: false,
                    cache: false,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                   
                        
                        $("#myTable_payment").html(data);
                      document.getElementById("form3").reset();
                    },
                    error: function(data){
                        alert(data);
                    }
                });
                return false;
              }

              function add_payment_input()
