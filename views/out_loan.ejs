<script>
    $(document).ready(()=>{
  $(function() {
  $('#date_man').datepicker({
       changeMonth: true,
       changeYear: true
   });
});

$('.price').keyup(()=>{
    $('.total').val($('.price').val()*$('.amount').val());
});

$('.amount').keyup(()=>{
    $('.total').val($('.price').val()*$('.amount').val());
});
    });
</script>

<script>
   $(function(){
    var item_name = $("#item_name").val();
    showUser(item_name);
  });

function showUser(id){
var data ={};

$.ajax({
    type: 'POST',
    data: JSON.stringify(data),
    contentType: "application/json",
    dataType:'json',
    url: '/get_stuff_loan?param='+id,                      
    success: function(data) {
   
        var js_arr = JSON.stringify(data);
        var str_array = js_arr.split(',');

       var newStr = js_arr.substring(1, js_arr.length-1);
       var parsedJSON = JSON.parse(newStr);
       var tazkira = parsedJSON.tazkira;
       //var last_name = parsedJSON.last_name;
     
       
       $("#tazkira_no").val(tazkira);
       //$("#emp_fname").val(last_name);
      //  $("#currency").val(currency);
      //  $("#to_dollar").val(ex_rate);
        
    },
    error: function(error) {
        console.log("some error in fetching the notifications");
    }
});
}

const $form = $('#form1')
  
  $form.on('submit', submitHandler)
  
  function submitHandler (e) {
    e.preventDefault()
    $.ajax({
      url: '/outgoing_loan',
      type:'POST',
      data: $form.serialize()
    }).done(response => {
      console.log(response)
    })
  }
</script>
