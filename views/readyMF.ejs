<script>

  const $form = $('#form1')
  
  $form.on('submit', submitHandler)
  
  function submitHandler (e) {
    e.preventDefault()
     //var mahsole_id = $("#dis_type").val();
     
          var selectedText = $("#dis_type option:selected").html();
          //alert(selectedText);
    
    $.ajax({
      url: '/stack_reg?innervalue='+selectedText,
      type:'POST',
      data: $form.serialize()
    }).done(response => {
      
      /* localStorage.setItem(10,response); */
      alert(response);
      document.getElementById("form1").reset();
      change_c();
      refreshStackList();
    })
  }

  function refreshStackList() {
    $.getJSON('/api/stack_list', function (data) {
      var list = data.stack_list || [];
      var dates = data.stack_date || [];
      var html = '';
      if (list.length === 0) {
        html = '<tr><td colspan="11" style="text-align: center;">هیچ رکوردی موجود نیست</td></tr>';
      } else {
        for (var i = 0; i < list.length; i++) {
          var row = list[i];
          var dateStr = dates[i] || (row.date || '');
          html += '<tr><td>' + (i + 1) + '</td><td>' + (row.item_name || '') + '</td><td>' + (row.item_type || '') + '</td><td>' + (row.quantity || '') + '</td><td>' + (row.fixed_price || '') + '</td><td>' + (row.sell_price || '') + '</td><td>' + (row.currency || '') + '</td><td>' + (row.ex_rate || '') + '</td><td>' + (row.serial_number || '') + '</td><td>' + dateStr + '</td><td><button data-toggle="tooltip" title="ویرایش" class="edt edit-tbl btn-stack-edit" data-id="' + row.id + '"><img width="15px" src="assets/img/last-project/edit.svg" alt=""></button> <button data-toggle="tooltip" title="حذف" class="edt del btn-stack-delete" data-id="' + row.id + '"><img width="15px" src="assets/img/last-project/delete.svg" alt=""></button></td></tr>';
        }
      }
      $("#stack_list_tbody").html(html);
    });
  }

  function show_all()
  {
    //var formData = new FormData(this);
      $.ajax({
          url: '/show_all_data_02',
          type: 'POST',
          //data: formData,
          async: false,
          cache: false,
          contentType: false,
          processData: false,
          success: function (data) {
           // alert("hello success ");
              $("#expens_tble_01").html(data);
             //document.getElementById("form2").reset();
          },
          error: function(data){
              alert(data);
          }
      });
      return false;
  }

  $("#form5").submit(function () {
    var dis_type = $("#dis_type").val();
              showUser(dis_type);
      var formData = new FormData(this);
      $.ajax({
          url: '/add_new_types_01',
          type: 'POST',
          data: formData,
          async: false,
          cache: false,
          contentType: false,
          processData: false,
          success: function (data) {
              // alert(data);
              
            
              $("#expens_tble_01").html(data);
              document.getElementById("form5").reset();
              window.location.href= "readyMF.ejs";
              
          },
          error: function(data){
              alert(data);
          }
      });
      return false;
  });

  function cat_delet(id)
  { 
    
           var result = confirm('are you sure ?');
                if(result == true)
                {
                  var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/delete_add_new_material_type?param='+id,                      
                        success: function(data) {
                        
                         $("#delete_row_"+id).remove();
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
                }
  }
 
  $("#update").css({"display":"none"});
  function cat_edit(id)
  {
    
                  $("#update").show();
                 
                  //alert(id);
                  var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/add_new_edit_type?param='+id,                      
                        success: function(data) {
                          var obj_to_staring = JSON.stringify(data);
                          var newStr = obj_to_staring.substring(1, obj_to_staring.length-1);
                          
                          var newStr1 = JSON.parse(newStr);
                          var ex_id = newStr1.id;
                          var mahsol_name = newStr1.name;
                          var type = newStr1.type;
                          var s_no = newStr1.serial_no;
                          $("#edit_id").val(ex_id);
                          $("#type").val(type);
                          $("#mahsol_name").val(mahsol_name);
                          $("#serial_no").val(s_no);
                         
                          //alert(cat);
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
               
  }


  function update_data()
  {
    var id = $("#edit_id").val();
    var mahsol_name = $("#mahsol_name").val();
    var type = $("#type").val();
    var ser_no = $("#serial_no").val();

    $.ajax({
          url: '/edit_add_type_02?id_val='+id+"&mahsol_name="+mahsol_name+"&type="+type+"&ser_no="+ser_no,
          type: 'POST',
          //data: formData,
          async: false,
          cache: false,
          contentType: false,
          processData: false,
          success: function (data) {
           // alert("hello success ");
              $("#expens_tble_01").html(data);
              document.getElementById("form5").reset();
          },
          error: function(data){
              alert(data);
          }
      });
      return false;
                   
  }

  function edit_stack_list(id) {
    $.ajax({
      type: 'POST',
      url: '/get_stack_to_market_list?param=' + id,
      contentType: "application/json",
      data: JSON.stringify({}),
      dataType: 'json',
      success: function (data) {
        var row = Array.isArray(data) && data.length > 0 ? data[0] : data;
        $("#stack_edit_id").val(row.id);
        $("#stack_item_name").val(row.item_name);
        $("#stack_item_type").val(row.item_type);
        $("#stack_quantity").val(row.quantity);
        $("#stack_fixed_price").val(row.fixed_price);
        $("#stack_sell_price").val(row.sell_price);
        $("#stack_currency").val(row.currency);
        $("#stack_ex_rate").val(row.ex_rate);
        $("#stack_serial_number").val(row.serial_number);
        $("#stackListEditModal").modal('show');
      },
      error: function () {
        alert('خطا در بارگذاری رکورد');
      }
    });
  }

  function delete_stack_list(id) {
    if (!confirm('آیا مطمئن هستید؟')) return;
    $.ajax({
      type: 'POST',
      url: '/delete_stack_to_market_list?param=' + id,
      contentType: "application/json",
      data: JSON.stringify({}),
      dataType: 'json',
      success: function () {
        refreshStackList();
      },
      error: function () {
        refreshStackList();
      }
    });
  }

  $("#form_stack_list_edit").on('submit', function (e) {
    e.preventDefault();
    $.ajax({
      url: '/update_stack_to_market_list',
      type: 'POST',
      data: $(this).serialize(),
      success: function () {
        $("#stackListEditModal").modal('hide');
        window.location.href = 'readyMF.ejs';
      },
      error: function (xhr) {
        alert(xhr.responseText || 'خطا در ذخیره');
      }
    });
    return false;
  });

  $(document).on('click', '.btn-stack-edit', function () {
    var id = $(this).data('id');
    if (id) edit_stack_list(id);
  });
  $(document).on('click', '.btn-stack-delete', function () {
    var id = $(this).data('id');
    if (id) delete_stack_list(id);
  });

  $(function(){
    var dis_type = $("#dis_type").val();
    
    showUser(dis_type);
  });

function showUser(id){
 
var data ={};

$.ajax({
    type: 'POST',
    data: JSON.stringify(data),
    contentType: "application/json",
    dataType:'json',
    url: '/get_all_types_2?param='+id,                      
    success: function(data) {
   
        var js_arr = JSON.stringify(data);
        var str_array = js_arr.split(',');
       

       var newStr = js_arr.substring(1, js_arr.length-1);
       var parsedJSON = JSON.parse(newStr);
       
       var serial_number = parsedJSON.serial_no;
       //alert(serial_number);
       var type = parsedJSON.type;
       $("#pro_no").val(serial_number);
       $("#item_type").val(type);
        
    },
    error: function(error) {
        console.log("some error in fetching the notifications");
    }
});
}
  </script>
