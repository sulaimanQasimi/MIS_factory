        <script>
          const $form = $('#rmf_reg_edit')
      $form.on('submit', submitHandler)
      
      function submitHandler (e) {
        e.preventDefault()
      
        $.ajax({
          url: '/update_rmf_material_01',
          type:'POST',
          data: $form.serialize()
        }).done(response => {
          console.log(response)
          window.location.href= "rmf_reg.ejs";
        })
      }
        </script>
        <script>

function delete1(id)
              {
                var result = confirm('are you sure ?');
                if(result == true)
                {
                  var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/raw_reg_delete?param='+id,                      
                        success: function(data) {
                           window.location.href= "rmf_reg.ejs";
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
                }
              }

              function update_rmf(id)
              {
                
                var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/update_rmf_regs?param='+id,                      
                        success: function(data) {
                          var obj_to_staring = JSON.stringify(data);//always server data is coming in object type we have to converted in string

                           var string_to_object = JSON.parse(obj_to_staring);//for accessing the value of key we have to convert to object
                           var shamsi_date = string_to_object.data;//our first part of data converted to object so we can access the value
                           var name1 = string_to_object.data1;//our second part of data still in string type so we again convt to obj

                           var pars2 = JSON.parse(name1);//here we have parse(convrt to obj) it again,because second parts was nested string

                          var expense_id= pars2.id;
                          var item_name= pars2.item_name;//now second part converted in obj so by using key we can access it's value
                          var item_type= pars2.item_type;
                          var quantity= pars2.quantity;
                          var fixed_price = pars2.fixed_price;
                          var sell_price = pars2.sell_price;
                          var currency = pars2.currency;
                          var ex_rate = pars2.ex_rate;
                          var id_number = pars2.serial_number;
                         
                          
                          $("#expense_id").val(expense_id);
                          $("#item_name").val(item_name);
                          $("#item_type").val(item_type);
                          $("#quantity").val(quantity);
                          $("#fixed_price").val(fixed_price);
                          $("#sell_price").val(sell_price);
                          $("#currency").val(currency);
                          $("#ex_rate").val(ex_rate);
                          $("#id_number").val(id_number);
                          $("#data_man").val(shamsi_date);
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
              }

              function view_mahsol(id)
              {
                        

                            $.ajax({
                                  url: '/update_show_edit3?id_val='+id,
                                  type: 'POST',
                                  //data: formData,
                                  async: false,
                                  cache: false,
                                  contentType: false,
                                  processData: false,
                                  success: function (data) {
                                  
                                  $("#myTable_payment").html(data);
                                    //document.getElementById("form2").reset();
                                  },
                                  error: function(data){
                                      alert(data);
                                  }
                              });
                              return false;
              }

              function from_to_date()
              {
                       $("#input_laoner").hide();
                   // var id = $("#edit_id").val();
                    var from_date =  $("#date_man").val();
                    var to_date =$("#date_man1").val();
                   
                      $.ajax({
                        url: '/from_date_to_rmf_reg_01?from_date='+from_date+'&to_date='+to_date,
                            type: 'POST',
                            //data: formData,
                            async: false,
                            cache: false,
                            contentType: false,
                            processData: false,
                            success: function (data) {
                           
                             $(".all_data").html(data);
                              
                            },
                            error: function(data){
                                alert(data);
                            }
                        });
                        return false;
              }
        </script>
