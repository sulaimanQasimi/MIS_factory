  <script>

function delete1(id)
              {
                var result = confirm('are you sure ?');
                if(result == true)
                {
                  var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/material_delete?param='+id,                      
                        success: function(data) {
                           window.location.href= "raw_material_store.ejs";
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
                }
              }

              function update_material(id)
              {
               // alert(id)
                var data ={};
                    $.ajax({
                        type: 'POST',
                        data: JSON.stringify(data),
                        contentType: "application/json",
                        dataType:'json',
                        url: '/update_materials?param='+id,                      
                        success: function(data) {
                          var obj_to_staring = JSON.stringify(data);//always server data is coming in object type we have to converted in string

                           var string_to_object = JSON.parse(obj_to_staring);//for accessing the value of key we have to convert to object
                           var shamsi_date = string_to_object.data;//our first part of data converted to object so we can access the value
                           var name1 = string_to_object.data1;//our second part of data still in string type so we again convt to obj

                           var pars2 = JSON.parse(name1);//here we have parse(convrt to obj) it again,because second parts was nested string

                          var material_id= pars2.id;
                          
                          var buy_type= pars2.item_type;//now second part converted in obj so by using key we can access it's value
                          var company_name= pars2.company_name;
                          var contact= pars2.contact;
                          var bill_no= pars2.bill_no;
                          var item_name= pars2.item_name;
                          var item_type= pars2.item_type;
                          var buy_place= pars2.buy_place;
                          var desc = pars2.description;
                          var quantity = pars2.quantity;
                          var price = pars2.price;
                          var paid_amount = pars2.price * pars2.quantity;
                          var profit_per_one = pars2.profit_per_one;
                         // var paid_amount= pars2.paid_amount;
                         // var desc = pars2.profit_per_one;
                          var date = string_to_object.date;//string_to_object
                          //alert(shamsi_date)
                          $("#expense_id").val(material_id);
                          $("#item_type").val(buy_type);
                          $("#company_name").val(company_name);
                          $("#contact").val(contact);
                          $("#bill_no").val(bill_no);
                          $("#item_name").val(item_name);
                          $("#inch").val(buy_place);
                          $("#buy_place").val(buy_place);
                          $("#description").val(desc);
                          $("#price").val(price);
                          $("#quantity").val(quantity);
                          $("#benefit").val(profit_per_one);
                          $("#recieved").val(paid_amount);
                          $("#data_man").val(shamsi_date);
                        },
                        error: function(error) {
                            console.log("some error in fetching the notifications");
                        }
                        });
              }
  </script>
