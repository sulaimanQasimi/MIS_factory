<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
  <form action="" enctype="multipart/form-data" method="post" id="form_n">
    <input type="file" name="fileupload">
    <input type="submit" value="submit">
  </form>
</body>
<script>

  const $form = $('#form_n')
    
    $form.on('submit', submitHandler)
    
    function submitHandler (e) {
      e.preventDefault()
      $.ajax({
        url: '/test',
        type:'POST',
        data: $form.serialize()
      }).done(response => {
        console.log(response)
      })
    }
  
  </script>
</html>