<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="dodgerblue" />
  <title>سیستم مدیریتی - مدیریت موجودی بازار</title>
  <!-- style -->
  <link rel="stylesheet" href="assets/css/bootstrap.min.css" />
  <link rel="stylesheet" href="assets/css/bootstrap-rtl.min.css" />
  <link rel="stylesheet" href="assets/css/font-awesome.min.css" />
  <link rel="stylesheet" href="assets/css/persian-datepicker.css">
  <link rel="stylesheet" href="assets/css/jquery-ui.css" />
  <link rel="stylesheet" href="assets/css/main.css" />
  <link rel="stylesheet" href="assets/css/emp.css" />
  <link rel="stylesheet" href="assets/css/dashboard.css" />
  <link rel="stylesheet" href="assets/css/scrollbar.css" />
  <link rel="stylesheet" href="assets/css/responsive.css" />
  <link rel="stylesheet" href="DataTables/datatables.min.css"/>
  <link rel="icon" href="assets/img/co-nav.png" />
  <!-- script -->
  <script src="assets/js/jquery.min.js"></script>
  <script src="assets/js/jquery-ui.js"></script>
  <script src="assets/js/popper.min.js"></script>
  <script src="assets/js/bootstrap.min.js"></script>
  <script src="assets/js/persian-datepicker.js"></script>
  <script src="DataTables/datatables.min.js"></script>
</head>
<body>
    <div class="container-fluid">
      <div class="row">
      <section class="all-web" >
        <h3 class="mt-5 mb-5 " style="text-align: center;">مدیریت موجودی بازار</h3>
        <hr>
        <br>
        
        <!-- Create/Edit Form -->
        <div class="card mb-4">
          <div class="card-header">
            <h4 id="form-title">ثبت موجودی جدید</h4>
          </div>
          <div class="card-body">
            <form action="" method="post" class="needs-validation" id="form1">
              <input type="hidden" id="edit_id" name="edit_id" value="">
              <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
                  <div class="form-group">
                    <label for="item_name">نام جنس:</label>
                    <input type="text" id="item_name" name="item_name" required class="form-control">
                  </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
                  <div class="form-group">
                    <label for="item_type">نوع جنس:</label>
                    <input type="text" id="item_type" name="item_type" required class="form-control">
                  </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
                  <div class="form-group">
                    <label for="fixed_price">قیمت ثابت:</label>
                    <input type="number" step="0.01" id="fixed_price" name="fixed_price" required class="form-control">
                  </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
                  <div class="form-group">
                    <label for="sell_price">قیمت فروش:</label>
                    <input type="number" step="0.01" id="sell_price" name="sell_price" required class="form-control">
                  </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
                  <div class="form-group">
                    <label for="quantity">تعداد:</label>
                    <input type="number" step="0.01" id="quantity" name="quantity" required class="form-control">
                  </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
                  <div class="form-group">
                    <label for="thickness">ضخامت:</label>
                    <input type="number" step="0.01" id="thickness" name="thickness" value="0" class="form-control">
                  </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
                  <div class="form-group">
                    <label for="remaining">باقیمانده (فقط خواندنی):</label>
                    <input type="number" step="0.01" id="remaining" name="remaining" readonly class="form-control" value="0">
                  </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3">
                  <div class="form-group">
                    <label>&nbsp;</label>
                    <div>
                      <button type="submit" class="btn btn-primary btn-block" id="submit-btn">ذخیره</button>
                      <button type="button" class="btn btn-secondary btn-block mt-2" id="cancel-btn" style="display:none;">لغو</button>
                    </div>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- Data Table -->
        <div class="card">
          <div class="card-header">
            <h4>لیست موجودی بازار</h4>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-striped table-bordered" id="dataTable">
                <thead>
                  <tr>
                    <th>شماره</th>
                    <th>نام جنس</th>
                    <th>نوع جنس</th>
                    <th>قیمت ثابت</th>
                    <th>قیمت فروش</th>
                    <th>تعداد</th>
                    <th>ضخامت</th>
                    <th>باقیمانده</th>
                    <th>عملیات</th>
                  </tr>
                </thead>
                <tbody id="table-body">
                  <% if(typeof data !== 'undefined' && data.length > 0) { %>
                    <% data.forEach(function(item, index) { %>
                      <tr id="row-<%= item.id %>">
                        <td><%= index + 1 %></td>
                        <td><%= item.item_name %></td>
                        <td><%= item.item_type %></td>
                        <td><%= item.fixed_price %></td>
                        <td><%= item.sell_price %></td>
                        <td><%= item.quantity %></td>
                        <td><%= item.thickness %></td>
                        <td><%= item.remaining %></td>
                        <td>
                          <button class="btn btn-sm btn-warning edit-btn" data-id="<%= item.id %>" title="ویرایش">
                            <i class="fa fa-edit"></i>
                          </button>
                          <button class="btn btn-sm btn-danger delete-btn" data-id="<%= item.id %>" title="حذف">
                            <i class="fa fa-trash"></i>
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="9" class="text-center">هیچ داده‌ای یافت نشد</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
      </div>
    </div>

<script src="assets/js/script.js"></script>
<script src="assets/js/form-valiate.js"></script>
<script>
  $(document).ready(function(){
    // Initialize DataTable
    if ($.fn.DataTable) {
      $('#dataTable').DataTable({
        "language": {
          "url": "//cdn.datatables.net/plug-ins/1.10.22/i18n/Persian.json"
        },
        "order": [[0, "asc"]],
        "pageLength": 25
      });
    }

    // Form submit handler
    const $form = $('#form1');
    $form.on('submit', submitHandler);
    
    function submitHandler(e) {
      e.preventDefault();
      const editId = $('#edit_id').val();
      const url = editId ? '/update_stack_to_market_list' : '/add_stack_to_market_list';
      
      $.ajax({
        url: url,
        type: 'POST',
        data: $form.serialize()
      }).done(function(response) {
        console.log(response);
        if (response.status === '1' || response.success) {
          alert('عملیات با موفقیت انجام شد');
          location.reload();
        } else {
          alert('خطا در انجام عملیات');
        }
      }).fail(function(error) {
        console.error('Error:', error);
        alert('خطا در ارتباط با سرور');
      });
    }

    // Cancel button handler
    $('#cancel-btn').on('click', function() {
      resetForm();
    });

    // Edit button handler
    $(document).on('click', '.edit-btn', function() {
      const id = $(this).data('id');
      editItem(id);
    });

    // Delete button handler
    $(document).on('click', '.delete-btn', function() {
      const id = $(this).data('id');
      deleteItem(id);
    });
  });

  function editItem(id) {
    $.ajax({
      type: 'POST',
      url: '/get_stack_to_market_list?param=' + id,
      contentType: "application/json",
      dataType: 'json',
      success: function(data) {
        if (data && data.length > 0) {
          const item = data[0];
          $('#edit_id').val(item.id);
          $('#item_name').val(item.item_name);
          $('#item_type').val(item.item_type);
          $('#fixed_price').val(item.fixed_price);
          $('#sell_price').val(item.sell_price);
          $('#quantity').val(item.quantity);
          $('#thickness').val(item.thickness);
          $('#remaining').val(item.remaining);
          
          $('#form-title').text('ویرایش موجودی');
          $('#submit-btn').text('بروزرسانی');
          $('#cancel-btn').show();
          
          // Scroll to form
          $('html, body').animate({
            scrollTop: $('.card').offset().top
          }, 500);
        }
      },
      error: function(error) {
        console.error('Error fetching item:', error);
        alert('خطا در دریافت اطلاعات');
      }
    });
  }

  function deleteItem(id) {
    if (confirm('آیا از حذف این مورد اطمینان دارید؟')) {
      $.ajax({
        type: 'POST',
        url: '/delete_stack_to_market_list?param=' + id,
        contentType: "application/json",
        dataType: 'json',
        success: function(data) {
          alert('مورد با موفقیت حذف شد');
          location.reload();
        },
        error: function(error) {
          console.error('Error deleting item:', error);
          alert('خطا در حذف مورد');
        }
      });
    }
  }

  function resetForm() {
    $('#form1')[0].reset();
    $('#edit_id').val('');
    $('#remaining').val('0');
    $('#form-title').text('ثبت موجودی جدید');
    $('#submit-btn').text('ذخیره');
    $('#cancel-btn').hide();
  }
</script>
</html>
